rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read shared broker portfolios if they have the link / ID
    match /portfolios/{portfolioId} {
      allow read: if true;
      allow write: if true; // Allows broker to publish/update without auth friction or when logged in
    }

    // User broker profile settings
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
